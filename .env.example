# Inti settings. scripts/init-env.mjs creates .env from this file and fills in the second block.
# Never commit .env. Every INTI_* value ships to the browser, so it must be public.

# ---- Fill in: values from your own accounts ----

# NEAR AI Cloud API key (cloud.near.ai). Server only.
NEAR_AI_API_KEY=
# NEAR Intents Agent API partner key and host (docs.agentsonintents.com).
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# Privy app (dashboard.privy.io): App ID, and the verification key from App settings > Basics >
# Verify with key instead, on one line with \n between the PEM lines.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Public URL of the agent API, and the exact web origins allowed to call it (comma separated; the
# first one is the app's own address). On a server: https://api.your-domain.com and https://your-domain.com.
INTI_API_URL=http://localhost:8787
SERVER_ALLOWED_ORIGINS=http://localhost:5173
# Kill switch: false pauses every agent cycle.
SERVER_AGENT_ENABLED=true
# Optional: NEAR RPC the server uses. Without it, https://free.rpc.fastnear.com.
# SERVER_NEAR_RPC_URL=https://free.rpc.fastnear.com
# Optional, server only: true also redirects www.<web domain> to the web domain (needs DNS for www).
# DEPLOY_WWW_REDIRECT=true

# ---- Generated by scripts/init-env.mjs: leave as they are ----

# Public key of Inti's function-call key; its key file stays in the data folder.
INTI_KEY_PUBLIC=
SERVER_INTI_KEY_FILE=
# Encrypts the stored trading grants. Changing it makes every stored grant unreadable.
SERVER_GRANT_KEY=
# Host of NEAR_INTENTS_AGENT_API_URL: the app signs grants only for it.
INTI_AGENT_API_HOST=
SERVER_GRANT_FILE=./grants.json
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Address of the reverse proxy in front of the server; empty when there is none.
SERVER_TRUSTED_PROXY=
