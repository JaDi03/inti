# Copy to .env and fill in. Never commit .env.
NEAR_INTENTS_AGENT_API_KEY=
# Use the demo host until the production key is confirmed.
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
NEAR_AI_API_KEY=
OWNER_ACCOUNT_ID=
# Provisional LLM until NEAR AI Cloud credits are available.
ANTHROPIC_API_KEY=
# Public Privy App ID for the web login (dashboard.privy.io). It ships to the browser.
PRIVY_APP_ID=

# Vault settings. Every INTI_* value ships to the browser: public values only, never a private key.
INTI_NETWORK=testnet
# Public key of Inti's function-call key (ed25519:...). Its private key stays on Inti's server.
INTI_KEY_PUBLIC=
# Testnet only: account that stands in for NEAR Intents and the agent (Intents has no testnet).
INTI_TESTNET_AGENT_ACCOUNT=
