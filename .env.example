# Copy to .env and fill in. Never commit .env.
NEAR_INTENTS_AGENT_API_KEY=
# Use the demo host until the production key is confirmed.
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# Agent brain on NEAR AI Cloud (cloud.near.ai). Server only.
NEAR_AI_API_KEY=
OWNER_ACCOUNT_ID=
# Public Privy App ID for the web login (dashboard.privy.io). It ships to the browser.
PRIVY_APP_ID=

# Spending Limits settings. Every INTI_* value ships to the browser: public values only, never a private key.
# Public key of Inti's function-call key (ed25519:...). Its private key stays on Inti's server.
INTI_KEY_PUBLIC=
# Public URL of Inti's agent API, used by the web chat.
INTI_API_URL=http://localhost:8787
# Host of the NEAR Intents Agent API (the host of NEAR_INTENTS_AGENT_API_URL). The app signs grants only for it.
INTI_AGENT_API_HOST=api.demo.agentsonintents.com

# Agent API server (pnpm server). SERVER_* values never reach the browser.
# The server also needs NEAR_INTENTS_AGENT_API_KEY and NEAR_INTENTS_AGENT_API_URL from above.
# Privy verification key, public (Privy dashboard > App settings > Basics > Verify with key instead).
# One line with \n between the PEM lines.
PRIVY_VERIFICATION_KEY=
# Exact web origins allowed to call the API, comma separated.
SERVER_ALLOWED_ORIGINS=http://localhost:5173
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Address of the reverse proxy in front of the server (e.g. 127.0.0.1), empty when there is none.
SERVER_TRUSTED_PROXY=
# Kill switch: false pauses every agent cycle.
SERVER_AGENT_ENABLED=true
# File where users' trading grants are kept, each encrypted with SERVER_GRANT_KEY.
SERVER_GRANT_FILE=./grants.json
# 32 random bytes in base64, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_GRANT_KEY=
# JSON file { "publicKey": "ed25519:...", "secretKey": "ed25519:..." } of Inti's function-call key. Keep it outside the repo.
SERVER_INTI_KEY_FILE=
SERVER_NEAR_RPC_URL=https://free.rpc.fastnear.com

# Production server (README, Self-host). On the server the same file sits at /home/inti/app/.env with:
#   INTI_API_URL=https://api.your-domain.com   SERVER_ALLOWED_ORIGINS=https://your-domain.com (first entry = web address)
#   SERVER_TRUSTED_PROXY=127.0.0.1             SERVER_GRANT_FILE=/home/inti/data/grants.json
#   SERVER_INTI_KEY_FILE=/home/inti/data/inti-key.json
# true also redirects www.<web domain> to the web domain (needs a DNS record for www).
DEPLOY_WWW_REDIRECT=false
