# The Inti agent API as a systemd service. scripts/server-update.sh installs it to
# /etc/systemd/system/inti-agent.service. It runs as the unprivileged user inti from
# /home/inti/app and may write only to /home/inti/data (grants file, Inti key file).
[Unit]
Description=Inti agent API
After=network-online.target
Wants=network-online.target

[Service]
User=inti
Group=inti
WorkingDirectory=/home/inti/app
ExecStart=/usr/local/bin/node --env-file=/home/inti/app/.env --import tsx agent/server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/inti/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# No Linux capabilities: the port is above 1024 and nothing needs root powers.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Files the agent creates are readable only by inti.
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
