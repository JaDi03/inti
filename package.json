{
  "name": "inti",
  "version": "0.0.0",
  "description": "Natural-language investment agent on NEAR Intents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch agent/index.ts",
    "start": "tsx agent/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "cycle": "tsx --env-file=.env agent/cli/cycle.ts",
    "server": "tsx --env-file=.env agent/server/index.ts",
    "web:dev": "pnpm --filter inti-web dev",
    "web:build": "pnpm --filter inti-web build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@near-intents-agent-api/sdk": "0.7.3",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "near-api-js": "7.4.0",
    "openai": "7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
